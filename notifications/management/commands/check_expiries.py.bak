"""
Management command to check expiries and create notifications.
"""

from django.core.management.base import BaseCommand
from django.utils import timezone
from datetime import date, timedelta

from customers.models import Customer
from notifications.models import Notification, NotificationPreference
from accounts.models import User


class Command(BaseCommand):
    help = 'Check document expiries and create notifications'
    
    def add_arguments(self, parser):
        parser.add_argument(
            '--days',
            nargs='+',
            type=int,
            default=[60, 30, 7, 0],
            help='Days thresholds to check (default: 60, 30, 7, 0)'
        )
        parser.add_argument(
            '--send-email',
            action='store_true',
            help='Send email notifications (if configured)'
        )
        parser.add_argument(
            '--dry-run',
            action='store_true',
            help='Show what would be done without creating notifications'
        )
    
    def handle(self, *args, **options):
        days_thresholds = options['days']
        send_email = options['send_email']
        dry_run = options['dry_run']
        
        if dry_run:
            self.stdout.write(self.style.WARNING('DRY RUN MODE - No notifications will be created'))
        
        today = date.today()
        created_count = 0
        skipped_count = 0
        
        for customer in Customer.objects.select_related('sales_person', 'sales_person__user_account').all():
            # Check each document type
            for field_name, doc_type, label in [
                ('trade_license_expiry', 'trade_license', 'Trade License'),
                ('passport_expiry', 'passport', 'Passport'),
                ('eid_expiry', 'emirates_id', 'Emirates ID'),
            ]:
                expiry_date = getattr(customer, field_name)
                if not expiry_date:
                    continue
                
                days_left = (expiry_date - today).days
                
                # Check if matches any threshold
                matched_threshold = None
                for threshold in sorted(days_thresholds):
                    if days_left == threshold:
                        matched_threshold = threshold
                        break
                
                if matched_threshold is None:
                    continue
                
                # Determine notification type
                if days_left < 0:
                    notif_type = Notification.Type.EXPIRED
                    title = f'{label} Expired: {customer.company_name}'
                    message = f'The {label.lower()} for {customer.company_name} expired on {expiry_date.strftime("%d %b %Y")} ({abs(days_left)} days ago).'
                elif days_left == 0:
                    notif_type = Notification.Type.EXPIRY_7_DAYS  # Treat as urgent
                    title = f'{label} Expires Today: {customer.company_name}'
                    message = f'The {label.lower()} for {customer.company_name} expires today ({expiry_date.strftime("%d %b %Y")}).'
                elif days_left <= 7:
                    notif_type = Notification.Type.EXPIRY_7_DAYS
                    title = f'{label} Expiring Soon: {customer.company_name}'
                    message = f'The {label.lower()} for {customer.company_name} expires in {days_left} days ({expiry_date.strftime("%d %b %Y")}).'
                elif days_left <= 30:
                    notif_type = Notification.Type.EXPIRY_30_DAYS
                    title = f'{label} Expiring in 30 Days: {customer.company_name}'
                    message = f'The {label.lower()} for {customer.company_name} expires in {days_left} days ({expiry_date.strftime("%d %b %Y")}).'
                elif days_left <= 60:
                    notif_type = Notification.Type.EXPIRY_60_DAYS
                    title = f'{label} Expiring in 60 Days: {customer.company_name}'
                    message = f'The {label.lower()} for {customer.company_name} expires in {days_left} days ({expiry_date.strftime("%d %b %Y")}).'
                else:
                    continue
                
                # Determine recipients
                recipients = []
                if customer.sales_person and customer.sales_person.user_account:
                    recipients.append(customer.sales_person.user_account)
                
                # Also notify admins
                admins = User.objects.filter(role=User.Role.ADMIN, is_active=True)
                recipients.extend(admins)
                
                # Remove duplicates
                recipients = list(set(recipients))
                
                for user in recipients:
                    # Check if notification already exists for this customer/document/type
                    existing = Notification.objects.filter(
                        user=user,
                        customer=customer,
                        type=notif_type,
                        document_type=doc_type,
                        status__in=[Notification.Status.UNREAD, Notification.Status.READ],
                        created_at__date=today,
                    ).exists()
                    
                    if existing:
                        skipped_count += 1
                        continue
                    
                    if not dry_run:
                        notification = Notification.objects.create(
                            user=user,
                            type=notif_type,
                            title=title,
                            message=message,
                            customer=customer,
                            document_type=doc_type,
                            expiry_date=expiry_date,
                        )
                        created_count += 1
                        
                        # Check user preferences for email
                        if send_email:
                            self.send_email_notification(user, notification)
                    else:
                        created_count += 1
        
        # Check missing documents
        for customer in Customer.objects.filter(copy_status__in=['partial', 'missing']).select_related('sales_person', 'sales_person__user_account'):
            recipients = []
            if customer.sales_person and customer.sales_person.user_account:
                recipients.append(customer.sales_person.user_account)
            recipients.extend(User.objects.filter(role=User.Role.ADMIN, is_active=True))
            recipients = list(set(recipients))
            
            for user in recipients:
                existing = Notification.objects.filter(
                    user=user,
                    customer=customer,
                    type=Notification.Type.MISSING_DOCUMENTS,
                    status__in=[Notification.Status.UNREAD, Notification.Status.READ],
                    created_at__date=today,
                ).exists()
                
                if existing:
                    skipped_count += 1
                    continue
                
                if not dry_run:
                    missing_docs = []
                    if not customer.documents.filter(document_type='trade_license').exists():
                        missing_docs.append('Trade License')
                    if not customer.documents.filter(document_type='passport').exists():
                        missing_docs.append('Passport')
                    if not customer.documents.filter(document_type='emirates_id').exists():
                        missing_docs.append('Emirates ID')
                    
                    Notification.objects.create(
                        user=user,
                        type=Notification.Type.MISSING_DOCUMENTS,
                        title=f'Missing Documents: {customer.company_name}',
                        message=f'{customer.company_name} is missing required documents: {", ".join(missing_docs)}.',
                        customer=customer,
                    )
                    created_count += 1
                else:
                    created_count += 1
        
        # Check pending cheques
        for customer in Customer.objects.filter(
            security_cheques__status__in=['pending', 'not_received']
        ).distinct().select_related('sales_person', 'sales_person__user_account'):
            recipients = []
            if customer.sales_person and customer.sales_person.user_account:
                recipients.append(customer.sales_person.user_account)
            recipients.extend(User.objects.filter(role=User.Role.ADMIN, is_active=True))
            recipients = list(set(recipients))
            
            for user in recipients:
                existing = Notification.objects.filter(
                    user=user,
                    customer=customer,
                    type=Notification.Type.CHEQUE_PENDING,
                    status__in=[Notification.Status.UNREAD, Notification.Status.READ],
                    created_at__date=today,
                ).exists()
                
                if existing:
                    skipped_count += 1
                    continue
                
                if not dry_run:
                    pending_cheques = customer.security_cheques.filter(status__in=['pending', 'not_received'])
                    Notification.objects.create(
                        user=user,
                        type=Notification.Type.CHEQUE_PENDING,
                        title=f'Pending Security Cheques: {customer.company_name}',
                        message=f'{customer.company_name} has {pending_cheques.count()} pending security cheque(s).',
                        customer=customer,
                    )
                    created_count += 1
                else:
                    created_count += 1
        
        self.stdout.write(
            self.style.SUCCESS(
                f'Completed: {created_count} notifications created, {skipped_count} skipped.'
            )
        )
    
    def send_email_notification(self, user, notification):
        """Send email notification if user has email preferences enabled."""
        try:
            prefs = user.notification_preferences
        except NotificationPreference.DoesNotExist:
            return
        
        # Map notification type to preference field
        email_fields = {
            Notification.Type.EXPIRY_60_DAYS: 'email_expiry_60_days',
            Notification.Type.EXPIRY_30_DAYS: 'email_expiry_30_days',
            Notification.Type.EXPIRY_7_DAYS: 'email_expiry_7_days',
            Notification.Type.EXPIRED: 'email_expired',
            Notification.Type.MISSING_DOCUMENTS: 'email_missing_documents',
            Notification.Type.CHEQUE_PENDING: 'email_cheque_pending',
        }
        
        field = email_fields.get(notification.type)
        if field and getattr(prefs, field, False):
            # Send email (implementation depends on email configuration)
            self.stdout.write(f'Would send email to {user.email} for {notification.title}')